{
  "name": "checkbox",
  "title": "Checkbox",
  "tier": "free",
  "category": "Selection",
  "description": "The tick draws itself in, the box squishes on press and a ring bursts out. Labels, descriptions and to-do strike-through.",
  "dependencies": [
    "react-native-svg"
  ],
  "registryDependencies": [
    "kit"
  ],
  "props": [
    [
      "checked / onChange",
      "boolean",
      "—",
      "Controlled state (or use defaultChecked)."
    ],
    [
      "defaultChecked",
      "boolean",
      "false",
      "Initial state when uncontrolled."
    ],
    [
      "label",
      "string",
      "—",
      "Text next to the box."
    ],
    [
      "description",
      "string",
      "—",
      "Secondary line."
    ],
    [
      "strike",
      "boolean",
      "false",
      "Strike the label through when checked."
    ],
    [
      "shape",
      "\"square\" | \"circle\"",
      "\"square\"",
      "Rounded square (corner = size / 3.4) or full circle."
    ],
    [
      "size",
      "number",
      "24",
      "Box width and height in points; the tick is 80% of it."
    ],
    [
      "accent",
      "string",
      "theme accent",
      "Checked colour."
    ],
    [
      "disabled",
      "boolean",
      "false",
      "Dims to 50% and blocks presses."
    ],
    [
      "style",
      "StyleProp<ViewStyle>",
      "—",
      "Style for the pressable row holding the box and label."
    ]
  ]
}
